+        const bool retry   = err == EINTR || err == ECONNABORTED;
+        const bool backoff = err == EMFILE || err == ENFILE;
+#endif
+        if (!retry && !backoff) {
+            LOG_ERROR("[%s] accept failed with error %d\n", __func__, err);
+            return nullptr;
+        }
+        LOG_WARN("[%s] accept failed with error %d, retrying\n", __func__, err);
+        if (backoff) {
+            // out of file descriptors, give them a moment to be released
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+        client_socket_fd = ::accept(pimpl->fd, NULL, NULL);
     }
